          "remedy variant = higher_lr_weighted"
        ],
        "metric_definitions": [
          "recovered_conditions requires fewer collapsed runs and positive mean Macro-F1 change"
        ],
        "executed_at": "2026-08-12T19:50:30+09:00"
      }
