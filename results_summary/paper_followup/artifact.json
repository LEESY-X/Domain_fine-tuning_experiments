        "id": "pilot_headline_query",
        "label": "Pilot collapse-recovery query",
        "path": "tools/build_paper_followup_report.py",
        "query": {
          "id": "pilot_headline_query",
          "engine": "sqlite",
          "sql": "SELECT COUNT(*) AS recovered_conditions\nFROM pilot_summary AS baseline\nJOIN pilot_summary AS remedy\n  ON baseline.task = remedy.task\n AND baseline.model = remedy.model\n AND baseline.method = remedy.method\nWHERE baseline.variant = 'baseline'\n  AND remedy.variant = 'higher_lr_weighted'\n  AND baseline.collapsed_runs > remedy.collapsed_runs\n  AND remedy.f1_mean > baseline.f1_mean",
          "description": "Counts paired pilot conditions where the combined remedy reduced collapsed runs and increased mean Macro-F1.",
          "tables_used": [
            "pilot_summary"
          ],
          "filters": [
            "baseline variant = baseline",
            "remedy variant = higher_lr_weighted"
          ],
          "metric_definitions": [
            "recovered_conditions requires fewer collapsed runs and positive mean Macro-F1 change"
          ],
          "executed_at": "2026-08-12T19:50:30+09:00"
        }
      },
      {
        "id": "full_headline_query",
        "label": "Full-data recovery query",
        "path": "tools/build_paper_followup_report.py",
        "query": {
          "id": "full_headline_query",
          "engine": "sqlite",
          "sql": "SELECT\n  SUM(CASE WHEN baseline_collapse_runs > remedy_collapse_runs AND delta_mean > 0 THEN 1 ELSE 0 END)\n    AS recovered_conditions,\n  SUM(CASE WHEN treatment_better_seeds = 5 THEN 1 ELSE 0 END)\n    AS all_positive_conditions\nFROM full_paired_comparison",
