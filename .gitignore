# GitHub/publication policy
#
# Keep in Git:
#   - source, configs, dependency specifications, tests and clean Colab runners
#   - final_tables/, results_summary/ and research_paper_ieie_spc/
#   - compact follow-up aggregate CSVs, environment records and provenance
#
# Keep out of Git:
#   - raw per-run predictions, histories, event logs, checkpoints and caches
#   - executed exploratory notebooks containing local paths or bulky outputs
#   - credentials, local environments and generated build intermediates


# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
kaggle.json
wandb_api_key*
huggingface_token*
hf_token*
credentials.json
service-account*.json


# Python environments, caches and packaging output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/


# IDE, editor and operating-system metadata
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
~$*


# Temporary files and local logs
*.log
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/
.cache/


# Notebook execution output is stripped before publication. Clean local and
# Colab runners remain tracked; transient notebook checkpoints do not.
.ipynb_checkpoints/


# Experiment trackers, caches and checkpoint directories
cache/
wandb/
lightning_logs/
runs/
outputs/
checkpoints/
**/checkpoints/


# Model weights and large binary tensors
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.h5
*.hdf5


# Downloaded datasets and array/cache formats
datasets/
data/raw/
data/interim/
*.arrow
*.parquet
*.feather
*.npy
*.npz


# Raw experiment results
# Ignore every result artifact first, then explicitly retain the compact
# publication evidence needed to audit the paper tables.
/results/**
!/results/environment.json
!/results/followup/
!/results/followup/provenance.json
!/results/followup/*/
!/results/followup/*/environment.json
!/results/followup/*/aggregate/
!/results/followup/*/aggregate/*.csv


# Generated report previews; Markdown/CSV/LaTeX source remains publishable.
/results_summary/paper_followup/*.html


# Private source manuscripts and local delivery bundles
#
# ORIGIN contains the pre-revision manuscript supplied for the merge.  output/
# contains locally assembled submission ZIPs, including a private supplement
# with per-run files.  Neither directory is part of the public code release.
/ORIGIN/
/output/


# The author-facing IEIE manuscript (including contact details and biographies)
# is maintained locally until every author approves publication.  Public code
# evidence referenced by the manuscript lives under release/ instead.
/research_paper_ieie_spc/


# LaTeX and PDF build intermediates
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
texput.fmt
texput.log


# Local render/preview directories
rendered/
renders/
preview/
previews/


# Archives are release artifacts, not source-controlled appendix material.
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.zip
